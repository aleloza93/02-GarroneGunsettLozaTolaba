          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"incidenteId\": 9202,\n  \"trabajoRealizado\": \"Se rearmo la llave termica y se verifico carga en tablero.\",\n  \"costo\": 0,\n  \"responsable\": \"Laura Mendez\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/informes-resolucion",
          "host": ["{{baseUrl}}"],

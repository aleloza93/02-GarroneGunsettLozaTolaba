      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"incidenteId\": 9203,\n  \"trabajoRealizado\": \"Intento de resolver incidente que sigue abierto\",\n  \"costo\": 0,\n  \"responsable\": \"Carlos Gomez\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/informes-resolucion",
          "host": ["{{baseUrl}}"],
          "path": ["informes-resolucion"]
        }
      }
    },
    {
      "name": "07 - Resolver segundo incidente con costo 0 (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",

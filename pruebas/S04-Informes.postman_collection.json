          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"incidenteId\": 999999,\n  \"trabajoRealizado\": \"Revision general de instalacion\",\n  \"costo\": 0,\n  \"responsable\": \"Carlos Gomez\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/informes-resolucion",

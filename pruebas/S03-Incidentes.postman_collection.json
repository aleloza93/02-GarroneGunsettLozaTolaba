          "name": "01 - Registrar incidente (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Estado inicial ABIERTO', () => pm.expect(json.estado).to.eql('ABIERTO'));",
                  "pm.test('Links HATEOAS', () => { pm.expect(json._links.self).to.exist; pm.expect(json._links.contrato).to.exist; pm.expect(json._links.informes).to.exist; });",
                  "pm.collectionVariables.set('incidenteId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contratoId\": 9001,\n  \"titulo\": \"Perdida de agua en lavadero\",\n  \"descripcion\": \"Gotea la conexion de la canilla del lavarropas\",\n  \"categoria\": \"PLOMERIA\",\n  \"prioridad\": \"ALTA\"\n}"
            },
